# Sleeper league id. Server-side only — never exposed to the browser.
SLEEPER_LEAGUE_ID=your_league_id_here

# Address the sponsorship buttons link to. NEXT_PUBLIC_ means it is inlined
# into the browser bundle at build time — correct here, since the address has
# to be in the page for anyone to contact you. Keep real secrets unprefixed.
NEXT_PUBLIC_SPONSOR_EMAIL=you@example.com
